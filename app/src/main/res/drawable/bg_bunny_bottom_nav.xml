<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#EFFFF9FC"
                android:centerColor="#F4FFE5F1"
                android:startColor="#FAFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80FF9DCD" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="1dp"
        android:right="8dp"
        android:bottom="38dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#66FFFFFF"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
