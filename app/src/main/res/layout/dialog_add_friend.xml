<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md">

    <View
        android:id="@+id/dialog_halo"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:alpha="0.32"
        android:background="@drawable/bg_butterfly_halo" />

    <View
        android:id="@+id/dialog_sheen"
        android:layout_width="230dp"
        android:layout_height="92dp"
        android:layout_gravity="top|end"
        android:alpha="0.2"
        android:background="@drawable/bg_butterfly_sheen"
        android:rotation="-18" />

    <LinearLayout
        android:id="@+id/layout_dialog_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_butterfly_glass_card"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加好友"
            android:textColor="@color/butterfly_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="输入 10 位扣扣号，先查找资料，再发送好友申请。"
            android:textColor="@color/butterfly_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_target_id"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_min_height"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_butterfly_input_bar"
            android:gravity="center_vertical"
            android:hint="请输入对方扣扣号"
            android:inputType="number"
            android:maxLength="10"
            android:paddingHorizontal="@dimen/input_horizontal_padding"
            android:textColor="@color/butterfly_text_primary"
            android:textColorHint="@color/butterfly_text_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_requests"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_secondary_height"
                android:background="@drawable/bg_profile_btn_outline"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingHorizontal="@dimen/space_md"
                android:text="申请"
                android:textColor="@color/butterfly_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_secondary_height"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_profile_btn_outline"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingHorizontal="@dimen/space_md"
                android:text="查找"
                android:textColor="@color/butterfly_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_user_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_butterfly_list_card"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_item_double_height"
            android:orientation="horizontal"
            android:padding="@dimen/card_inner_padding"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_preview_avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_preview_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="等待查找"
                    android:textColor="@color/butterfly_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="扣扣号"
                    android:textColor="@color/butterfly_cyan"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_preview_signature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="查找到用户后，这里会显示个性签名。"
                    android:textColor="@color/butterfly_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_secondary_height"
                android:background="@drawable/bg_profile_btn_outline"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="@dimen/space_md"
                android:text="取消"
                android:textColor="@color/butterfly_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_secondary_height"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_button_gradient_20"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingHorizontal="@dimen/space_md"
                android:text="发送申请"
                android:textColor="@color/butterfly_pearl"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
